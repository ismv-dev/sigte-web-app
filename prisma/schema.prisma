// S.I.G.T.E. — Esquema de datos con Marco Integral de Ciberseguridad
// Base: SQLite para desarrollo local / PostgreSQL para producción (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuarios y roles (RBAC) ─────────────────────────────────────────────────
enum Role {
  USER
  GUARD
  ADMIN
}

// Tipo de usuario del campus, según los datos que solicita Dirección de Sede.
enum UserType {
  STAFF   // Funcionario / Docente
  STUDENT // Alumno
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(USER)
  universityId        String?   @unique // Credencial universitaria (rut/matrícula)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // ── Identificación solicitada por Dirección de Sede (Sujeta a Minimización RT-03) ──
  userType            UserType?
  phone               String?   // Teléfono de contacto
  // Funcionario / Docente
  position            String?   // Cargo
  department          String?   // Departamento o Unidad
  // Alumno
  rut                 String?   @unique // RUT
  academicDepartment  String?   // Departamento Académico
  career              String?   // Carrera

  vehicles            Vehicle[]
  notifications       Notification[]
  accessLogs          AccessLog[]    @relation("UserAccess")
  guardLogs           AccessLog[]    @relation("GuardLogs")
  infractions         Infraction[]   @relation("UserInfractions")
  reportedInfractions Infraction[]   @relation("GuardInfractions")
  resolvedInfractions Infraction[]   @relation("ResolvedInfractions")
  resetTokens         PasswordResetToken[]
}

// ─── Tokens de recuperación de contraseña ───────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Vehículos (Cifrado en reposo y Blind Indexing RT-04) ────────────────────
model Vehicle {
  id              String   @id @default(uuid())
  plate           String   @unique
  // Campos de confidencialidad y búsqueda ciega
  plateCipher     String?  // Matrícula cifrada con AES-256-GCM
  plateIv         String?  // Vector de inicialización de 12 bytes
  plateTag        String?  // Tag de autenticación GCM (16 bytes)
  plateBlindIndex String?  @unique // Hash determinista HMAC-SHA256(plate, salt)

  make            String?
  model           String?
  color           String?
  authorized      Boolean  @default(true)
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accessLogs      AccessLog[]
  infractions     Infraction[]
  currentBlockId  String?
  currentBlock    ParkingBlock? @relation(fields: [currentBlockId], references: [id])

  @@index([ownerId])
  @@index([plateBlindIndex])
}

// ─── Bloques de estacionamiento ──────────────────────────────────────────────
model ParkingBlock {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  capacity    Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles    Vehicle[]
  accessLogs  AccessLog[]
}

// ─── Log de accesos (entrada/salida) ─────────────────────────────────────────
enum AccessDirection {
  IN
  OUT
}

enum AccessMethod {
  PLATE
  QR
  CARD
  MANUAL
}

model AccessLog {
  id             String          @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation("UserAccess", fields: [userId], references: [id])
  guardId        String?
  guard          User?           @relation("GuardLogs", fields: [guardId], references: [id])
  method         AccessMethod
  direction      AccessDirection
  blockId        String?
  block          ParkingBlock?   @relation(fields: [blockId], references: [id])
  timestamp      DateTime        @default(now())
  authorized     Boolean         @default(true)
  note           String?

  // Enlace a bitácora de sellado inmutable (RT-06)
  auditHash      String?

  @@index([timestamp])
  @@index([vehicleId])
  @@index([userId])
}

// ─── Infracciones ────────────────────────────────────────────────────────────
enum InfractionType {
  WRONG_BLOCK
  UNAUTHORIZED_ENTRY
  DOUBLE_PARKING
  EXPIRED_PERMIT
  BLOCKING_ACCESS
  SPEEDING
  OTHER
}

enum InfractionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Infraction {
  id          String           @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation("UserInfractions", fields: [userId], references: [id])
  guardId     String
  guard       User             @relation("GuardInfractions", fields: [guardId], references: [id])
  type        InfractionType
  description String
  status      InfractionStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  resolvedById String?
  resolvedBy   User?            @relation("ResolvedInfractions", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolution   String?
  evidenceUrl  String?

  // Enlace a bitácora de sellado inmutable (RT-06)
  auditHash    String?

  @@index([userId])
  @@index([vehicleId])
}

// ─── Control Anti-Replay: Nonces utilizados (RT-01, RQ-05) ───────────────────
model UsedNonce {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String?
  vehicleId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([jti])
}

// ─── Bitácora Inmutable Encadenada (Tamper-Proof Chaining) (RT-06, RQ-04) ─────
model SecurityAuditLog {
  id             String   @id @default(uuid())
  sequenceNumber Int      @default(autoincrement()) @unique
  previousHash   String
  currentHash    String   @unique
  eventPayload   String   // JSON canónico del evento
  actorHash      String   // Hash seudonimizado del operador/sistema
  action         String   // p. ej. ACCESS_GRANTED, REPLAY_ATTACK_DETECTED, etc.
  timestamp      DateTime @default(now())

  @@index([timestamp])
  @@index([sequenceNumber])
}

// ─── Registro de Eventos de Seguridad y Detección de Anomalías (RQ-07) ───────
model SecurityEvent {
  id        String   @id @default(uuid())
  type      String   // AUTH_FAILURE, REPLAY_ATTACK, RATE_LIMIT_EXCEEDED, BOLA_ATTEMPT, TAMPER_DETECTED
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  ipAddress String?
  actorHash String?
  details   String?  // JSON sanitizado
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([type])
  @@index([severity])
}

// ─── Push tokens (Expo) ──────────────────────────────────────────────────────
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Notificaciones ──────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
