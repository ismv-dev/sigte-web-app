# Base de datos PostgreSQL (Neon) — la lee prisma/schema.prisma
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# JWT — cambiar por un secreto seguro en producción (mínimo 32 caracteres).
# Obligatoria en producción: si falta, el servidor no arranca (no hay fallback inseguro).
JWT_SECRET="cambia-esto-en-produccion-usa-openssl-rand-hex-32"
JWT_ISSUER="sigte.local"
JWT_AUDIENCE="sigte.app"

# Secreto para firmar los QR de acceso efímeros (HMAC-SHA256, RT-01).
# Recomendado definir uno propio: openssl rand -hex 32
QR_SECRET="cambia-esto-qr-secret-en-produccion-32-chars"

# Clave simétrica de 256 bits para cifrado de patentes en reposo AES-256-GCM (RT-04).
# openssl rand -hex 32
PLATE_ENCRYPTION_KEY="cambia-esto-plate-key-32-bytes-hex-32chars"

# Sal secreta institucional fija para Blind Indexing (HMAC-SHA256) (RT-04).
BLIND_INDEX_SALT="sal-institucional-ciega-usm-sigte-2026"

# Clave institucional externa segregada (K_audit) para sellado de bitácoras inmutables (RT-06).
# No debe residir en la base de datos.
AUDIT_SECRET_KEY="clave-segregada-k-audit-inmutable-32chars"

# Clave API de servicio para autenticación de cámaras/nodos LPR (RT-08).
LPR_API_KEY="clave-servicio-nodo-lpr-institucional-token"

# CORS: origen permitido para peticiones del navegador a /api. Por defecto usa
# APP_URL. La app móvil (Expo) es nativa y no requiere CORS. Usar "*" solo si
# se acepta el riesgo.
CORS_ORIGIN=""

# Envío de email (recuperación de contraseña) vía Resend — resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# URL pública de la app, usada para armar el link del correo de reseteo
APP_URL="http://localhost:3000"

# Seed (prisma/seed.ts): en producción está bloqueado salvo ALLOW_PROD_SEED=true.
# SEED_PASSWORD sobreescribe las contraseñas demo (que son públicas en el repo).
ALLOW_PROD_SEED=""
SEED_PASSWORD=""
